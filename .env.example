# Public browser configuration returned by /api/config.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only. Never expose either value in browser code or VITE_* variables.
SUPABASE_SERVICE_ROLE_KEY=replace_me
CLIENTFLOW_HANDOFF_SECRET=replace_with_32_or_more_random_bytes
# Alias accepted by the receiver if CLIENTFLOW_HANDOFF_SECRET is unset:
# CLIENTFLOW_WEBHOOK_SECRET=

# Receiver replay controls.
CLIENTFLOW_REPLAY_WINDOW_SECONDS=300
CLIENTFLOW_ALLOWED_CLOCK_SKEW_SECONDS=30
